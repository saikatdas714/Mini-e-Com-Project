<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/style.css">

    <title>Create Admin</title>
</head>

<body>

    <h1 class="text-center mt-5">Create Admin</h1>

    <div class="form container mt-5 box">

        <form method="post" action="/create-admin" class="row g-5">

            <div class="col-md-12">
                <input
                    type="text"
                    class="form-control"
                    name="name"
                    placeholder="Name"
                    required
                >
            </div>

            <div class="col-md-12">
                <input
                    type="email"
                    class="form-control"
                    name="email"
                    placeholder="Email"
                    required
                >
            </div>

            <div class="col-md-12">
                <input
                    type="password"
                    class="form-control"
                    name="password"
                    placeholder="Password"
                    required
                >
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary w-100">
                    Create Admin
                </button>
            </div>

        </form>

    </div>

</body>

</html>