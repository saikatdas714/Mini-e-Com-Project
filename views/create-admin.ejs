<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Admin - Mini e-Com Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="bag-check-fill.svg">
 
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-box">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <div>
                    <span>Mini e-Com</span>
                    <span class="brand-subtext">Admin Portal</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none p-1 text-white" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-white"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                        </li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-badge-tag">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span><%= user.email.split('@')[0] %></span>
                            <span class="role-pill"><%= user.role %></span>
                        </div>
                        <a href="/logout" class="btn btn-secondary-retail py-1 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary-retail py-1 px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a href="/signup" class="btn btn-secondary-retail py-1 px-3">
                            Sign Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="auth-wrapper">
        <div class="form-card">
            <h1 class="form-title">Create Admin User</h1>
            <p class="form-subtitle">Provision an account with administrative permissions</p>

            <form method="POST" action="/create-admin">
                <!-- Name -->
                <div class="mb-3">
                    <label for="name" class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="Admin Name" required>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="admin@example.com" required>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary-retail w-100 py-2 fs-6">
                    <i class="bi bi-shield-check"></i> Create Admin Account
                </button>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container text-center">
            <p class="mb-0 text-secondary small">&copy; 2026 Mini e-Com. Admin Management System.</p>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>