<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Product - Mini e-Com Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <span>Mini e-Com</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link active" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                    </li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-profile-badge">
                            <i class="bi bi-person-circle text-primary fs-6"></i>
                            <span><%= user.email.split('@')[0] %></span>
                            <span class="role-tag <%= user.role === 'admin' ? 'role-admin' : 'role-user' %>">
                                <%= user.role %>
                            </span>
                        </div>
                        <a href="/logout" class="btn btn-modern-secondary py-2 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right text-danger"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-modern-secondary py-2 px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a href="/signup" class="btn btn-modern-primary py-2 px-3">
                            <i class="bi bi-person-plus"></i> Sign Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <div class="form-icon-circle">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <h1 class="form-title">Add New Product</h1>
                <p class="form-subtitle">Create a new item in your store inventory with pricing and details</p>
            </div>

            <form method="POST" action="/add-product">
                <!-- Product Name -->
                <div class="mb-3">
                    <label for="name" class="form-label">Product Name</label>
                    <div class="input-icon-group">
                        <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Wireless Noise-Canceling Headphones" required>
                        <i class="bi bi-tag input-icon"></i>
                    </div>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label for="price" class="form-label">Price (INR)</label>
                    <div class="input-icon-group">
                        <input type="number" class="form-control" id="price" name="price" placeholder="1999" step="0.01" min="0" required>
                        <i class="bi bi-currency-rupee input-icon"></i>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="3" placeholder="Provide key highlights and product features..." required></textarea>
                </div>

                <!-- Image URL -->
                <div class="mb-4">
                    <label for="image" class="form-label">Image URL</label>
                    <div class="input-icon-group">
                        <input type="url" class="form-control" id="image" name="image" placeholder="https://example.com/product-image.jpg" oninput="previewProductImage(this.value)">
                        <i class="bi bi-image input-icon"></i>
                    </div>

                    <!-- Live Image Previewer -->
                    <div class="image-preview-container" id="preview-box">
                        <div class="preview-placeholder" id="placeholder-text">
                            <i class="bi bi-card-image fs-3"></i>
                            <span>Image preview will appear here</span>
                        </div>
                        <img id="preview-img" src="" alt="Preview" style="display: none;" onerror="onImgError()">
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-modern-primary w-100 py-3 fs-6">
                    <i class="bi bi-cloud-arrow-up-fill"></i> Publish Product
                </button>
            </form>
        </div>
    </div>

    <!-- Footer -->
        <footer class="footer-custom">
            <div class="d-flex align-items-center justify-content-center gap-2">
                        <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                            rel="noopener noreferrer" class="footer-social-btn" title="Follow on Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                            class="footer-social-btn" title="View GitHub Profile">
                            <i class="bi bi-github"></i>
                        </a>
                        <div>
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
            </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function previewProductImage(url) {
            const previewImg = document.getElementById('preview-img');
            const placeholder = document.getElementById('placeholder-text');
            if (url && url.trim() !== '') {
                previewImg.src = url;
                previewImg.style.display = 'block';
                placeholder.style.display = 'none';
            } else {
                previewImg.style.display = 'none';
                placeholder.style.display = 'flex';
            }
        }
        function onImgError() {
            const previewImg = document.getElementById('preview-img');
            const placeholder = document.getElementById('placeholder-text');
            previewImg.style.display = 'none';
            placeholder.style.display = 'flex';
            placeholder.innerHTML = '<i class="bi bi-exclamation-triangle text-danger fs-3"></i><span class="text-danger">Invalid image URL</span>';
        }
    </script>
</body>

</html>