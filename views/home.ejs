<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini e-Com</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <span>Mini e-Com</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
                    </li>
                    <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                        </li>
                        <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !=='undefined' && user) { %>
                        <div class="user-profile-badge">
                            <i class="bi bi-person-circle text-primary fs-6"></i>
                            <span>
                                <%= user.email.split('@')[0] %>
                            </span>
                            <span class="role-tag <%= user.role === 'admin' ? 'role-admin' : 'role-user' %>">
                                <%= user.role %>
                            </span>
                        </div>
                        <a href="/logout" class="btn btn-modern-secondary py-2 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right text-danger"></i> Logout
                        </a>
                        <% } else { %>
                            <a href="/login" class="btn btn-modern-secondary py-2 px-3">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                            <a href="/signup" class="btn btn-modern-primary py-2 px-3">
                                <i class="bi bi-person-plus"></i> Sign Up
                            </a>
                            <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="hero-section">
        <div class="container">
            <div class="row align-items-center justify-content-between g-4 g-lg-5">
                <div class="col-lg-7">
                    <h1 class="hero-title">
                        Discover extraordinary products for your <span class="gradient-text">everyday lifestyle</span>
                    </h1>
                    <p class="hero-subtitle">
                        Explore handpicked, premium quality items designed to elevate your style, work, and living
                        spaces with instant doorstep delivery.
                    </p>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="#products-section" class="btn btn-modern-primary py-3 px-4 shadow-lg">
                            <i class="bi bi-bag-check-fill"></i> Start Shopping
                        </a>
                        <a href="/cart" class="btn btn-modern-secondary py-3 px-4">
                            <i class="bi bi-cart3"></i> View Cart
                        </a>
                    </div>
                </div>

                <div class="col-lg-5 text-center d-none d-lg-block">
                    <div class="position-relative p-4">
                        <div class="card border-0 shadow-xl rounded-4 overflow-hidden"
                            style="background: linear-gradient(135deg, #4f46e5, #ec4899); color: white; padding: 2.5rem 2rem;">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="badge bg-white text-dark rounded-pill px-3 py-2 fw-bold">🔥 Hot
                                    Deals</span>
                                <span class="text-white-50"><i class="bi bi-shield-check"></i> Verified Store</span>
                            </div>
                            <h3 class="fw-bold mb-3">Up to 40% Off</h3>
                            <p class="text-white-50 mb-4">Get the best value deals on trending gadgets, lifestyle
                                accessories & more.</p>
                            <div class="p-3 bg-white bg-opacity-25 rounded-3 text-start backdrop-blur">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-white text-primary rounded-circle p-2 d-flex align-items-center justify-content-center"
                                        style="width: 42px; height: 42px;">
                                        <i class="bi bi-truck fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white small">Free Standard Shipping</div>
                                        <div class="text-white-50 small">On all orders over ₹499</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features Bar -->
            <div class="features-strip">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
                    <div class="col">
                        <div class="feature-pill">
                            <div class="feature-icon-box"><i class="bi bi-lightning-charge-fill"></i></div>
                            <div>
                                <h6>Fast Delivery</h6>
                                <p>Dispatched in 24 hours</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="feature-pill">
                            <div class="feature-icon-box"><i class="bi bi-shield-lock-fill"></i></div>
                            <div>
                                <h6>Secure Payments</h6>
                                <p>100% Encrypted & Safe</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="feature-pill">
                            <div class="feature-icon-box"><i class="bi bi-arrow-repeat"></i></div>
                            <div>
                                <h6>Easy Returns</h6>
                                <p>7-day replacement policy</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="feature-pill">
                            <div class="feature-icon-box"><i class="bi bi-headset"></i></div>
                            <div>
                                <h6>24/7 Support</h6>
                                <p>Dedicated assistance</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Products Catalog -->
    <main class="container my-5" id="products-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small" style="letter-spacing: 0.08em;">Our
                    Catalog</span>
                <h2 class="fw-800 mb-0">Featured Products</h2>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Showing <%= products ? products.length : 0 %> products</span>
            </div>
        </div>

        <% if (!products || products.length===0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h3 class="empty-state-title">No products available yet</h3>
                <p class="empty-state-desc">
                    Our catalog is being updated with fresh arrivals. Please check back shortly or add new items.
                </p>
                <% if (typeof user !=='undefined' && user && user.role==='admin' ) { %>
                    <a href="/add-product" class="btn btn-modern-primary">
                        <i class="bi bi-plus-circle"></i> Add First Product
                    </a>
                    <% } %>
            </div>
            <% } else { %>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    <% products.forEach(element=> { %>
                        <div class="col">
                            <div class="product-card">
                                <div class="product-img-wrapper">
                                    <span class="product-tag"><i class="bi bi-tag-fill me-1"></i> Special</span>
                                    <img src="<%= element.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80' %>"
                                        class="product-img" alt="<%= element.name %>"
                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80';">
                                </div>

                                <div class="product-body">
                                    <div class="d-flex align-items-center gap-1 text-warning mb-2"
                                        style="font-size: 0.85rem;">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-half"></i>
                                        <span class="text-muted ms-1 small fw-semibold">4.8 (124)</span>
                                    </div>

                                    <h3 class="product-title" title="<%= element.name %>">
                                        <%= element.name %>
                                    </h3>

                                    <p class="product-desc">
                                        <%= element.description %>
                                    </p>

                                    <div class="product-footer">
                                        <div class="product-price-box">
                                            <span class="price-label">Price</span>
                                            <div class="product-price">
                                                <span class="currency">₹</span>
                                                <%= Number(element.price).toLocaleString('en-IN') %>
                                            </div>
                                        </div>

                                        <form action="/cart/<%= element.id %>" method="POST" class="m-0">
                                            <button type="submit" class="btn btn-modern-primary">
                                                <i class="bi bi-cart-plus-fill"></i> Add to Cart
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </main>

    <!-- Modern Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <!-- Brand & Description Column -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand">
                        <div class="brand-icon-wrapper" style="width: 34px; height: 34px; font-size: 1.1rem;">
                            <i class="bi bi-bag-heart-fill"></i>
                        </div>
                        <span>Mini e-Com</span>
                    </div>
                    <p class="footer-desc">
                        Your trusted destination for quality goods, smart gadgets, and effortless online shopping with
                        seamless doorstep delivery.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                            rel="noopener noreferrer" class="footer-social-btn" title="Follow on Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                            class="footer-social-btn" title="View GitHub Profile">
                            <i class="bi bi-github"></i>
                        </a>
                    </div>
                </div>

                <!-- Navigation Links -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h4 class="footer-heading">Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="/"><i class="bi bi-chevron-right small text-primary"></i> Home</a></li>
                        <li><a href="/cart"><i class="bi bi-chevron-right small text-primary"></i> My Cart</a></li>
                        <li><a href="/login"><i class="bi bi-chevron-right small text-primary"></i> Login</a></li>
                        <li><a href="/signup"><i class="bi bi-chevron-right small text-primary"></i> Sign Up</a></li>
                    </ul>
                </div>

                <!-- Features & Policies -->
                <div class="col-6 col-md-3 col-lg-3">
                    <h4 class="footer-heading">Shopping Benefits</h4>
                    <ul class="footer-links">
                        <li><a href="#products-section"><i class="bi bi-check2-circle text-success"></i> Free Standard Shipping</a></li>
                        <li><a href="#products-section"><i class="bi bi-check2-circle text-success"></i> 7-Day Easy Returns</a></li>
                        <li><a href="#products-section"><i class="bi bi-check2-circle text-success"></i> 100% Authentic Items</a></li>
                        <li><a href="#products-section"><i class="bi bi-check2-circle text-success"></i> 24/7 Dedicated Support</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Copyright Bar -->
            <div class="footer-bottom">
                <div class="small">
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>