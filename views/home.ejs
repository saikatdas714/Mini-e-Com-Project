<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini e-Com - Online Shopping Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="bag-check-fill.svg">
   
 
</head>

<body>
    <!-- Navbar (Amazon/Flipkart Style) -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-box">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <div>
                    <span>Mini e-Com</span>
                    <span class="brand-subtext">E-commerce Website</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none p-1 text-white" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-white"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="bi bi-house-door"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                        </li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-badge-tag">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span><%= user.email.split('@')[0] %></span>
                            <span class="role-pill"><%= user.role %></span>
                        </div>
                        <a href="/logout" class="btn btn-secondary-retail py-1 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary-retail py-1 px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a href="/signup" class="btn btn-secondary-retail py-1 px-3">
                            Sign Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>


    <!-- Main Content -->
    <main class="container my-3">
        <!-- Hero / Promo Banner -->
        <div class="hero-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-primary text-white mb-2 px-2 py-1">Big Savings Days</span>
                    <h1 class="hero-title">
                        Discover Quality Products at <span class="highlight">Unbeatable Prices</span>
                    </h1>
                    <p class="hero-desc">
                        Shop the latest trending gadgets, lifestyle essentials, and accessories with fast, free delivery on orders above ₹499.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#products-section" class="btn btn-primary-retail py-2 px-4">
                            <i class="bi bi-bag"></i> Shop Now
                        </a>
                        <a href="/cart" class="btn btn-secondary-retail py-2 px-3">
                            <i class="bi bi-cart3"></i> View Cart
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 text-center d-none d-lg-block">
                    <div class="p-3 bg-light rounded border text-start">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <i class="bi bi-truck fs-3 text-primary"></i>
                            <div>
                                <div class="fw-bold">Free & Fast Delivery</div>
                                <div class="text-secondary small">Dispatched in 24 Hours</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-shield-check fs-3 text-success"></i>
                            <div>
                                <div class="fw-bold">100% Genuine Items</div>
                                <div class="text-secondary small">7-Day Return Policy</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trust Strip -->
        <div class="trust-strip d-none d-sm-block">
            <div class="row row-cols-2 row-cols-md-4 g-2 text-center">
                <div class="col">
                    <div class="trust-item justify-content-center">
                        <i class="bi bi-truck trust-icon"></i>
                        <div class="text-start">
                            <div class="trust-title">Free Delivery</div>
                            <div class="trust-subtitle">Orders over ₹499</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="trust-item justify-content-center">
                        <i class="bi bi-shield-lock trust-icon"></i>
                        <div class="text-start">
                            <div class="trust-title">Secure Payment</div>
                            <div class="trust-subtitle">100% Protected</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="trust-item justify-content-center">
                        <i class="bi bi-arrow-clockwise trust-icon"></i>
                        <div class="text-start">
                            <div class="trust-title">Easy Returns</div>
                            <div class="trust-subtitle">7 Days Policy</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="trust-item justify-content-center">
                        <i class="bi bi-headset trust-icon"></i>
                        <div class="text-start">
                            <div class="trust-title">24/7 Help Desk</div>
                            <div class="trust-subtitle">Dedicated Support</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="d-flex align-items-center justify-content-between my-3" id="products-section">
            <div>
                <h2 class="fs-4 fw-bold mb-0">Deals of the Day</h2>
                <div class="text-secondary small">Top picks for you</div>
            </div>
            <div class="text-secondary small">
                Showing <%= products ? products.length : 0 %> items
            </div>
        </div>

        <% if (!products || products.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h3 class="empty-state-title">No products listed</h3>
                <p class="empty-state-desc">
                    Products are currently being added to the catalog. Check back shortly.
                </p>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <a href="/add-product" class="btn btn-primary-retail">
                        <i class="bi bi-plus-circle"></i> Add First Product
                    </a>
                <% } %>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                <% products.forEach(element => { %>
                    <div class="col">
                        <div class="product-card">
                            <span class="product-discount-tag">Special Price</span>
                            
                            <div class="product-img-box">
                                <img src="<%= element.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80' %>"
                                     class="product-img" 
                                     alt="<%= element.name %>"
                                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80';">
                            </div>

                            <div class="product-body">
                                <h3 class="product-title" title="<%= element.name %>">
                                    <%= element.name %>
                                </h3>

                                <div class="product-rating">
                                    <span class="rating-badge">
                                        4.4 <i class="bi bi-star-fill" style="font-size: 0.65rem;"></i>
                                    </span>
                                    <span class="rating-count">(128 reviews)</span>
                                </div>

                                <p class="product-desc">
                                    <%= element.description %>
                                </p>

                                <div class="product-price-row">
                                    <div class="product-price-current">
                                        ₹<%= Number(element.price).toLocaleString('en-IN') %>
                                    </div>
                                    <span class="text-success small fw-bold">Free Delivery</span>
                                </div>

                                <form action="/cart/<%= element.id %>" method="POST" class="m-0 mt-auto">
                                    <button type="submit" class="btn btn-cart-retail w-100">
                                        <i class="bi bi-cart-plus-fill"></i> Add to Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <!-- Brand Column -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="brand-icon-box" style="width: 28px; height: 28px; font-size: 0.95rem;">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <span class="fw-bold text-white fs-5">Mini e-Com</span>
                    </div>
                    <p class="text-secondary small mb-3">
                        Your reliable destination for everyday essentials, quality electronics, and fast home delivery.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                            rel="noopener noreferrer" class="footer-social-btn" title="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                            class="footer-social-btn" title="GitHub">
                            <i class="bi bi-github"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h4 class="footer-heading">About</h4>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/cart">Shopping Cart</a></li>
                        <li><a href="/login">Customer Login</a></li>
                        <li><a href="/signup">Create Account</a></li>
                    </ul>
                </div>

                <!-- Customer Care -->
                <div class="col-6 col-md-3 col-lg-3">
                    <h4 class="footer-heading">Customer Care</h4>
                    <ul class="footer-links">
                        <li><a href="#products-section">Payments & Security</a></li>
                        <li><a href="#products-section">Shipping Rates & Policies</a></li>
                        <li><a href="#products-section">Returns & Replacements</a></li>
                        <li><a href="#products-section">Help Center (24x7)</a></li>
                    </ul>
                </div>
            </div>

            <!-- Bottom Copyright Bar -->
            <div class="footer-bottom">
                <div>
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
                <div class="d-flex align-items-center gap-3 mt-2 mt-md-0">
                    <span><i class="bi bi-shield-check text-success"></i> 100% Purchase Protection</span>
                    <span><i class="bi bi-credit-card"></i> Visa / Master / UPI</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>