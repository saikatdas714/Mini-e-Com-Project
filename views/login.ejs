<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Mini e-Com</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <span>Mini e-Com</span>
            </a>
            
            <div>
                <a href="/signup" class="btn btn-modern-secondary py-2 px-3">
                    <i class="bi bi-person-plus"></i> Create Account
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Auth Card -->
    <div class="auth-wrapper">
        <div class="form-card">
            <div class="form-header">
                <div class="form-icon-circle">
                    <i class="bi bi-person-lock"></i>
                </div>
                <h1 class="form-title">Welcome Back</h1>
                <p class="form-subtitle">Enter your credentials to access your account & cart</p>
            </div>

            <form method="POST" action="/login">
                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <div class="input-icon-group">
                        <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                        <i class="bi bi-envelope input-icon"></i>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label for="inputPassword4" class="form-label">Password</label>
                    <div class="input-icon-group">
                        <input type="password" class="form-control" id="inputPassword4" name="password" placeholder="••••••••" required>
                        <i class="bi bi-lock input-icon"></i>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-modern-primary w-100 py-3 fs-6 mb-3">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In to Account
                </button>

                <div class="text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account yet? 
                        <a href="/signup" class="fw-bold text-primary">Create an account</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-custom">
            <div class="d-flex align-items-center justify-content-center gap-2">
                        <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                            rel="noopener noreferrer" class="footer-social-btn" title="Follow on Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                            class="footer-social-btn" title="View GitHub Profile">
                            <i class="bi bi-github"></i>
                        </a>
                        <div>
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
            </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>