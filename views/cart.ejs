<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - Mini e-Com</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <span>Mini e-Com</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cart"><i class="bi bi-cart3"></i> Cart</a>
                    </li>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                    </li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-profile-badge">
                            <i class="bi bi-person-circle text-primary fs-6"></i>
                            <span><%= user.email.split('@')[0] %></span>
                            <span class="role-tag <%= user.role === 'admin' ? 'role-admin' : 'role-user' %>">
                                <%= user.role %>
                            </span>
                        </div>
                        <a href="/logout" class="btn btn-modern-secondary py-2 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right text-danger"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-modern-secondary py-2 px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a href="/signup" class="btn btn-modern-primary py-2 px-3">
                            <i class="bi bi-person-plus"></i> Sign Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Cart Content -->
    <main class="container cart-container">
        <!-- Breadcrumb / Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-2 border-bottom">
            <div>
                <h1 class="fw-800 fs-2 mb-1">Shopping Cart</h1>
                <p class="text-muted mb-0 small">Review and manage items before proceeding to secure checkout.</p>
            </div>
            <div>
                <a href="/" class="btn btn-modern-secondary">
                    <i class="bi bi-arrow-left"></i> Continue Shopping
                </a>
            </div>
        </div>

        <% if (!cart || cart.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h2 class="empty-state-title">Your Cart is Empty</h2>
                <p class="empty-state-desc">
                    Looks like you haven't added anything to your cart yet. Explore our featured collection and find something you'll love!
                </p>
                <a href="/" class="btn btn-modern-primary py-3 px-4 shadow">
                    <i class="bi bi-bag-plus-fill"></i> Browse Catalog
                </a>
            </div>
        <% } else { 
            let subtotal = 0;
            cart.forEach(item => {
                subtotal += Number(item.price) || 0;
            });
            let shipping = 0;
            let tax = Math.round(subtotal * 0.18);
            let grandTotal = subtotal + shipping + tax;
        %>
            <div class="row g-4">
                <!-- Cart Items List (Left Column) -->
                <div class="col-lg-8">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="fw-bold text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                            Cart Items (<%= cart.length %>)
                        </span>
                    </div>

                    <% cart.forEach(product => { %>
                        <div class="cart-item-card">
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300&auto=format&fit=crop&q=80' %>"
                                 class="cart-item-img"
                                 alt="<%= product.name %>"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300&auto=format&fit=crop&q=80';">

                            <div class="cart-item-details">
                                <h3 class="cart-item-title"><%= product.name %></h3>
                                <p class="cart-item-desc"><%= product.description %></p>
                                
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-2">
                                    <div class="cart-item-price">
                                        ₹<%= Number(product.price).toLocaleString('en-IN') %>
                                    </div>

                                    <form action="/cart/remove/<%= product.product_id %>" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-modern-danger" title="Remove item">
                                            <i class="bi bi-trash3-fill"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>

                    <div class="p-3 rounded-3 bg-light border d-flex align-items-center gap-3 mt-3">
                        <i class="bi bi-truck text-primary fs-3"></i>
                        <div>
                            <div class="fw-bold small text-dark">Free Delivery Unlocked!</div>
                            <div class="text-muted small">All orders in your cart qualify for zero-cost standard shipping.</div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary (Right Column) -->
                <div class="col-lg-4">
                    <div class="summary-card">
                        <h3 class="summary-title">
                            <i class="bi bi-receipt text-primary"></i> Order Summary
                        </h3>

                        <div class="summary-row">
                            <span>Subtotal (<%= cart.length %> items)</span>
                            <span class="fw-bold text-dark">₹<%= subtotal.toLocaleString('en-IN') %></span>
                        </div>

                        <div class="summary-row">
                            <span>Estimated Tax (GST 18%)</span>
                            <span class="fw-bold text-dark">₹<%= tax.toLocaleString('en-IN') %></span>
                        </div>

                        <div class="summary-row">
                            <span>Delivery Charges</span>
                            <span class="text-success fw-bold">FREE</span>
                        </div>

                        <!-- Promo Code input -->
                        <div class="my-3">
                            <label class="form-label small text-muted">Promo Code</label>
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="DISCOUNT20" style="text-transform: uppercase;">
                                <button class="btn btn-modern-secondary px-3" type="button">Apply</button>
                            </div>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold text-dark fs-5">Grand Total</span>
                            <span class="summary-total text-primary">₹<%= grandTotal.toLocaleString('en-IN') %></span>
                        </div>

                        <button type="button" class="btn btn-modern-primary w-100 py-3 shadow-lg fs-6 fw-bold" onclick="alert('Proceeding to checkout! (Simulation)')">
                            <i class="bi bi-lock-fill"></i> Proceed to Checkout
                        </button>

                        <div class="text-center mt-3">
                            <span class="text-muted small d-inline-flex align-items-center gap-1">
                                <i class="bi bi-shield-check text-success"></i> 100% Secure & Encrypted Checkout
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

    <footer class="footer-custom footer-compact">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 text-center">
                <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                    rel="noopener noreferrer" class="footer-social-btn" title="Follow on Instagram">
                    <i class="bi bi-instagram"></i>
                </a>
                <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                    class="footer-social-btn" title="View GitHub Profile">
                    <i class="bi bi-github"></i>
                </a>
                <div class="small">
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
            </div>
        </div>
    </footer>
    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>