<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - Mini e-Com</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom Style -->
    <link rel="stylesheet" href="/style.css">
     <link rel="icon" type="image/svg+xml" href="/bag-check-fill.svg">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/">
                <div class="brand-icon-box">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <div>
                    <span>Mini e-Com</span>
                    <span class="brand-subtext">Explore Plus</span>
                </div>
            </a>

            <button class="navbar-toggler border-0 shadow-none p-1 text-white" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-white"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house-door"></i> Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cart">
                            <i class="bi bi-cart3"></i> Cart
                            <span class="badge rounded-pill bg-warning text-dark ms-1 nav-cart-badge" id="navCartBadge" style="<%= (typeof cartCount !== 'undefined' && cartCount > 0) ? '' : 'display: none;' %>">
                                <%= (typeof cartCount !== 'undefined' && cartCount > 0) ? cartCount : '' %>
                            </span>
                        </a>
                    </li>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/add-product"><i class="bi bi-plus-circle"></i> Add Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/create-admin"><i class="bi bi-shield-lock"></i> Create Admin</a>
                        </li>
                    <% } %>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-badge-tag">
                            <i class="bi bi-person-circle fs-6"></i>
                            <span><%= user.email.split('@')[0] %></span>
                            <span class="role-pill"><%= user.role %></span>
                        </div>
                        <a href="/logout" class="btn btn-secondary-retail py-1 px-3" title="Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary-retail py-1 px-3">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                        <a href="/signup" class="btn btn-secondary-retail py-1 px-3">
                            Sign Up
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container cart-section">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
            <h1 class="fs-4 fw-bold mb-0">Shopping Cart</h1>
            <a href="/" class="btn btn-secondary-retail">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
        </div>

        <% if (!cart || cart.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h2 class="empty-state-title">Your Cart is Empty!</h2>
                <p class="empty-state-desc">
                    Explore our daily deals and discover great products at the best prices.
                </p>
                <a href="/" class="btn btn-primary-retail py-2 px-4">
                    <i class="bi bi-bag"></i> Shop Now
                </a>
            </div>
        <% } else { 
            let subtotal = 0;
            cart.forEach(item => {
                subtotal += Number(item.price) || 0;
            });
            let delivery = 0;
            let totalAmount = subtotal + delivery;
        %>
            <div class="row g-4">
                <!-- Cart Items List (Left Column) -->
                <div class="col-lg-8">
                    <div class="fw-semibold text-secondary small mb-2">
                        ITEMS IN CART (<%= cart.length %>)
                    </div>

                    <% cart.forEach(product => { %>
                        <div class="cart-item-card">
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300&auto=format&fit=crop&q=80' %>"
                                 class="cart-item-img"
                                 alt="<%= product.name %>"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300&auto=format&fit=crop&q=80';">

                            <div class="d-flex flex-column flex-grow-1">
                                <h3 class="cart-item-title"><%= product.name %></h3>
                                <p class="text-secondary small mb-2"><%= product.description %></p>
                                <span class="text-success small fw-semibold mb-2">
                                    <i class="bi bi-check-circle-fill"></i> In Stock & Eligible for FREE Delivery
                                </span>

                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-auto pt-2 border-top">
                                    <div class="cart-item-price">
                                        ₹<%= Number(product.price).toLocaleString('en-IN') %>
                                    </div>

                                    <form action="/cart/remove/<%= product.product_id %>" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-danger-retail" title="Remove">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>

                    <div class="p-3 bg-white border rounded d-flex align-items-center gap-3 mt-3">
                        <i class="bi bi-shield-check text-success fs-3"></i>
                        <div>
                            <div class="fw-bold small">Safe and Secure Payments</div>
                            <div class="text-secondary small">100% Authentic products and easy 7-day return policy.</div>
                        </div>
                    </div>
                </div>

                <!-- Price Breakdown (Right Column) -->
                <div class="col-lg-4">
                    <div class="order-summary-card">
                        <div class="summary-header">
                            PRICE DETAILS
                        </div>

                        <div class="summary-body">
                            <div class="summary-row">
                                <span>Price (<%= cart.length %> items)</span>
                                <span>₹<%= subtotal.toLocaleString('en-IN') %></span>
                            </div>

                            <div class="summary-row">
                                <span>Delivery Charges</span>
                                <span class="text-success fw-bold">FREE</span>
                            </div>

                            <div class="summary-total-row">
                                <span>Total Amount</span>
                                <span>₹<%= totalAmount.toLocaleString('en-IN') %></span>
                            </div>

                            <button type="button" class="btn-buy-retail" onclick="openCheckoutModal()">
                                <i class="bi bi-lightning-fill"></i> PLACE ORDER
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Custom Animated E-Commerce Modal -->
            <div id="checkoutCustomModal" class="custom-modal-backdrop" onclick="handleBackdropClick(event)">
                <div class="custom-modal-card">
                    <!-- Modal Header -->
                    <div class="custom-modal-header">
                        <h5 class="custom-modal-title" id="modalHeaderTitle">
                            <i class="bi bi-qr-code-scan text-warning"></i> Complete UPI Payment
                        </h5>
                        <button type="button" class="custom-modal-close-btn" onclick="closeCheckoutModal()" aria-label="Close">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Modal Body: Confirmation & Payment Stage -->
                    <div id="modalConfirmStage" class="custom-modal-body">
                        <!-- UPI QR Code Payment Box -->
                        <div class="upi-qr-card text-center mb-3">
                            <div class="fw-bold text-dark mb-1">Scan to Pay with Any UPI App</div>
                            <div class="text-secondary small mb-2">Google Pay &bull; PhonePe &bull; Paytm &bull; BHIM</div>
                            
                            <div class="d-flex justify-content-center my-2">
                                <img src="/upi-qr.jpg" alt="Google Pay UPI QR Code" style="width: 175px; height: auto; border-radius: 8px; border: 1px solid #e2e8f0; display: block;" />
                            </div>

                            <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
                                <span class="badge bg-light text-dark border font-monospace py-1 px-2">UPI ID: dalok7320-2@oksbi</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="copyUpiId('dalok7320-2@oksbi', this)" title="Copy UPI ID">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>

                            <div class="fw-bold text-dark mt-2 pt-2 border-top">
                                Amount to Pay: <span class="text-accent fs-6">₹<%= totalAmount.toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <!-- Payment Screenshot Upload -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Upload Payment Confirmation Screenshot <span class="text-danger">*</span>
                            </label>
                            <input type="file" id="paymentScreenshotInput" name="paymentProof" accept="image/*" class="d-none" onchange="handleScreenshotSelect(this)">

                            <div id="uploadDropzone" class="upload-dropzone p-3 text-center" onclick="document.getElementById('paymentScreenshotInput').click()">
                                <div id="dropzoneEmpty">
                                    <i class="bi bi-cloud-arrow-up text-primary fs-3 d-block mb-1"></i>
                                    <span class="small fw-semibold text-dark d-block">Click to upload payment screenshot</span>
                                    <span class="text-secondary" style="font-size: 11px;">Supports PNG, JPG, JPEG, WEBP (Max 10MB)</span>
                                </div>
                                <div id="dropzonePreview" class="d-none align-items-center justify-content-between text-start gap-2">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                                        <img id="screenshotThumb" src="" alt="Screenshot" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid #cbd5e1;">
                                        <div class="overflow-hidden">
                                            <div id="screenshotFileName" class="small fw-bold text-dark text-truncate"></div>
                                            <div id="screenshotFileSize" class="text-secondary" style="font-size: 11px;"></div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" onclick="removeScreenshot(event)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div id="screenshotErrorMsg" class="text-danger small mt-1 d-none">
                                <i class="bi bi-exclamation-circle"></i> Please upload your payment confirmation screenshot.
                            </div>
                        </div>

                        <div class="modal-summary-box mb-3">
                            <div class="modal-summary-row">
                                <span>Items in Cart</span>
                                <span class="fw-semibold text-dark"><%= cart.length %> items</span>
                            </div>
                            <div class="modal-summary-row total">
                                <span>Total Amount</span>
                                <span class="text-accent">₹<%= totalAmount.toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <div class="custom-modal-footer px-0 pb-0 mt-3 border-0 bg-transparent">
                            <button type="button" class="btn btn-secondary-retail py-2 px-3" onclick="closeCheckoutModal()">
                                Cancel
                            </button>
                            <button type="button" class="btn-buy-retail py-2 px-4 w-auto m-0" id="btnConfirmCheckout" onclick="processCheckout()">
                                <i class="bi bi-check-circle-fill"></i> Submit Payment & Order
                            </button>
                        </div>
                    </div>

                    <!-- Modal Body: Success Stage -->
                    <div id="modalSuccessStage" class="custom-modal-body text-center" style="display: none;">
                        <div class="success-icon-wrapper">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <h3 class="fs-4 fw-bold text-dark mb-2">Order Placed Successfully!</h3>
                        <p class="text-secondary small mb-4">
                            Thank you for your purchase! Your order has been placed and is now being processed.
                        </p>

                        <div class="d-flex justify-content-center gap-2">
                            <a href="/" class="btn-buy-retail py-2 px-4 text-decoration-none w-auto">
                                <i class="bi bi-bag"></i> Continue Shopping
                            </a>
                        </div>
                    </div>

                    <!-- Modal Body: Error Stage -->
                    <div id="modalErrorStage" class="custom-modal-body text-center" style="display: none;">
                        <div class="success-icon-wrapper" style="border-color: #ef4444; background: #fef2f2; color: #ef4444; box-shadow: 0 0 0 8px rgba(239, 68, 68, 0.15);">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <h4 class="fw-bold text-dark mb-2">Order Could Not Be Completed</h4>
                        <p class="text-secondary small mb-4" id="errorMessageText">
                            Something went wrong while placing your order. Please try again.
                        </p>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-secondary-retail py-2 px-4" onclick="closeCheckoutModal()">
                                Close
                            </button>
                            <button type="button" class="btn-buy-retail py-2 px-4 w-auto m-0" onclick="resetToConfirmStage()">
                                Try Again
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        <% } %>
    </main>

    <!-- Modal Controller Script -->
    <script>
        function openCheckoutModal() {
            const modal = document.getElementById('checkoutCustomModal');
            if (modal) {
                resetToConfirmStage();
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeCheckoutModal() {
            const modal = document.getElementById('checkoutCustomModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function handleBackdropClick(event) {
            if (event.target.id === 'checkoutCustomModal') {
                closeCheckoutModal();
            }
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeCheckoutModal();
            }
        });

        function resetToConfirmStage() {
            document.getElementById('modalConfirmStage').style.display = 'block';
            document.getElementById('modalSuccessStage').style.display = 'none';
            document.getElementById('modalErrorStage').style.display = 'none';
            document.getElementById('modalHeaderTitle').innerHTML = '<i class="bi bi-qr-code-scan text-warning"></i> Complete UPI Payment';

            const btn = document.getElementById('btnConfirmCheckout');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Submit Payment & Order';
            }
        }

        function copyUpiId(text, btn) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    const original = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-outline-secondary');
                    setTimeout(() => {
                        btn.innerHTML = original;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-secondary');
                    }, 2000);
                });
            }
        }

        function handleScreenshotSelect(input) {
            const dropzone = document.getElementById('uploadDropzone');
            const errorMsg = document.getElementById('screenshotErrorMsg');
            const dropzoneEmpty = document.getElementById('dropzoneEmpty');
            const dropzonePreview = document.getElementById('dropzonePreview');
            const thumb = document.getElementById('screenshotThumb');
            const nameEl = document.getElementById('screenshotFileName');
            const sizeEl = document.getElementById('screenshotFileSize');

            if (input.files && input.files[0]) {
                const file = input.files[0];
                dropzone.classList.remove('has-error');
                errorMsg.classList.add('d-none');

                nameEl.innerText = file.name;
                sizeEl.innerText = (file.size / 1024).toFixed(1) + ' KB';

                const reader = new FileReader();
                reader.onload = function(e) {
                    thumb.src = e.target.result;
                    dropzoneEmpty.classList.add('d-none');
                    dropzonePreview.classList.remove('d-none');
                    dropzonePreview.classList.add('d-flex');
                };
                reader.readAsDataURL(file);
            }
        }

        function removeScreenshot(event) {
            if (event) event.stopPropagation();
            const input = document.getElementById('paymentScreenshotInput');
            if (input) input.value = '';
            const dropzoneEmpty = document.getElementById('dropzoneEmpty');
            const dropzonePreview = document.getElementById('dropzonePreview');
            if (dropzoneEmpty) dropzoneEmpty.classList.remove('d-none');
            if (dropzonePreview) {
                dropzonePreview.classList.remove('d-flex');
                dropzonePreview.classList.add('d-none');
            }
        }

        async function processCheckout() {
            const fileInput = document.getElementById('paymentScreenshotInput');
            const errorMsg = document.getElementById('screenshotErrorMsg');
            const dropzone = document.getElementById('uploadDropzone');

            if (!fileInput || !fileInput.files || !fileInput.files[0]) {
                errorMsg.classList.remove('d-none');
                dropzone.classList.add('has-error');
                return;
            }

            const btn = document.getElementById('btnConfirmCheckout');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting Order...';

            const formData = new FormData();
            formData.append('paymentProof', fileInput.files[0]);

            try {
                const response = await fetch('/cart/checkout', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    // Transition to Success Stage
                    document.getElementById('modalConfirmStage').style.display = 'none';
                    document.getElementById('modalErrorStage').style.display = 'none';
                    document.getElementById('modalSuccessStage').style.display = 'block';
                    document.getElementById('modalHeaderTitle').innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Order Confirmed';

                    const navBadge = document.getElementById('navCartBadge');
                    if (navBadge) {
                        navBadge.innerText = '';
                        navBadge.style.display = 'none';
                    }
                } else {
                    // Transition to Error Stage
                    document.getElementById('modalConfirmStage').style.display = 'none';
                    document.getElementById('modalSuccessStage').style.display = 'none';
                    document.getElementById('modalErrorStage').style.display = 'block';
                    document.getElementById('modalHeaderTitle').innerHTML = '<i class="bi bi-exclamation-circle text-danger"></i> Checkout Notice';
                    document.getElementById('errorMessageText').innerText = data.message || 'Unable to place order. Please check your cart and try again.';
                }
            } catch (err) {
                console.error('Checkout error:', err);
                document.getElementById('modalConfirmStage').style.display = 'none';
                document.getElementById('modalSuccessStage').style.display = 'none';
                document.getElementById('modalErrorStage').style.display = 'block';
                document.getElementById('modalHeaderTitle').innerHTML = '<i class="bi bi-exclamation-circle text-danger"></i> Checkout Notice';
                document.getElementById('errorMessageText').innerText = 'Network error occurred. Please check your connection and try again.';
            }
        }
    </script>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    &copy; 2026 Mini e-Com. Created by <a href="https://github.com/saikatdas714" target="_blank"
                        rel="noopener noreferrer" class="text-white fw-semibold">Saikat Das</a>.
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="https://www.instagram.com/saikatdas620?igsi=MTM5eWN3bWZ6YTFzMw==" target="_blank"
                        rel="noopener noreferrer" class="footer-social-btn" title="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="https://github.com/saikatdas714" target="_blank" rel="noopener noreferrer"
                        class="footer-social-btn" title="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>